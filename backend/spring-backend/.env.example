# Spring Boot backend — environment template
# Copy values into your environment (or a git-ignored .env loader) — never commit real secrets.

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/billing_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# JWT signing secret — MUST be at least 32 characters for HS256
APP_JWT_SECRET=generate-a-long-random-string-here-min-32-chars
APP_JWT_EXPIRATION_MS=86400000

# Razorpay Payment Gateway (secret is server-side only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# Brand name used in AI assistant / WhatsApp messages
BUSINESS_NAME=All In One Bill

# WhatsApp Business Cloud API (Meta)
# WHATSAPP_ACCESS_TOKEN: permanent token from Meta Business Settings > System Users
#   with scopes whatsapp_business_messaging + whatsapp_business_management
# WHATSAPP_PHONE_NUMBER_ID: Meta App Dashboard > WhatsApp > API Setup > "Phone number ID"
# WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account (WABA) id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
# Any random string; must match what you type in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=tsarit-billing-webhook
# Pre-approved OTP template name (e.g. otp_verification); empty = plain-text fallback
WHATSAPP_OTP_TEMPLATE=
# Own-SIM SMS gateway (free). Phone with unlimited-SMS plan polls the queue.
# Optional shared secret so only your phones can register/drain the queue.
SMS_GATEWAY_API_KEY=change-me-long-random
SMS_GATEWAY_BATCH=10
WHATSAPP_DEFAULT_COUNTRY_CODE=91
