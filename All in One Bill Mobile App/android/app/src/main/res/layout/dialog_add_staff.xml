<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Staff Member"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etStaffName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Staff Name *"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etStaffMobile"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Mobile Number"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etStaffRole"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Role (Salesman, Manager...)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etStaffSalary"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Monthly Salary ₹"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />
</LinearLayout>
