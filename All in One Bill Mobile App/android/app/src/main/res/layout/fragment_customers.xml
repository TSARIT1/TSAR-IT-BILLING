<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etCustomerSearch"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_card_surface"
        android:drawableStart="@drawable/ic_nav_customers"
        android:drawablePadding="10dp"
        android:hint="Search parties by name or phone..."
        android:paddingHorizontal="14dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/progressCustomers"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/colorGold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvEmptyCustomers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="No parties found.\nTap + Add Party to create your first customer!"
        android:textColor="@color/colorTextMuted"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginTop="12dp"
        android:contentDescription="Add Party"
        android:src="@drawable/ic_nav_customers"
        android:tint="@color/white"
        app:backgroundTint="@color/colorPrimary"
        app:fabSize="normal"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
