<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drawer_header"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="38dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Top Row: Full Brand Avatar + Active Plan Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDrawerLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_drawer_avatar"
            android:contentDescription="Business Logo"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_tsar_it" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDrawerPlanBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="👑 PRO TRIAL"
            android:textColor="#FFE4B5"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full Business Profile Details (No Truncation) -->
    <TextView
        android:id="@+id/tvDrawerBusinessName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="TSAR IT Enterprise"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Rajesh Kumar (Owner)"
        android:textColor="#FFE4B5"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDrawerEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="user@tsaritservices.com"
        android:textColor="#E0E0E0"
        android:textSize="11sp" />

    <!-- Interactive Full Profile View & Edit Badge -->
    <TextView
        android:id="@+id/tvDrawerEditPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drawer_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="✏️ View Full Profile &amp; Edit"
        android:textColor="@color/white"
        android:textSize="11sp" />

</LinearLayout>
