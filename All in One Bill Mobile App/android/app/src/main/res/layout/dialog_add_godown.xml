<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvGodownDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Godown"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGodownName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Godown Name *"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etGodownLocation"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Location"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etGodownManager"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Manager Name"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etGodownContact"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Contact Number"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />
</LinearLayout>
