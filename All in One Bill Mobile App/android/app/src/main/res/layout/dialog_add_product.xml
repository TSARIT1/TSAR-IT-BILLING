<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvInvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Item"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etItemName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Item Name *"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etItemCode"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Item Code / SKU *"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etItemPrice"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Sale Price ₹ *"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etItemStock"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Opening Stock"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextMuted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etItemTax"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="GST %"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etItemBarcode"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Barcode"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextMuted"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etItemUnit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Unit (PCS, KG, BOX...)"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />
</LinearLayout>
