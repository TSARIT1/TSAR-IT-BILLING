<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_press_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar circle with initials -->
    <TextView
        android:id="@+id/tvCustomerAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_badge_paid"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/colorGold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Customer Name"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCustomerPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91 0000000000"
            android:textColor="@color/colorTextMuted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvCustomerType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer"
            android:textColor="@color/colorTextMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCustomerCall"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Call"
        android:src="@android:drawable/sym_action_call"
        app:tint="@color/colorSuccess" />

    <ImageButton
        android:id="@+id/btnCustomerDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/colorDanger" />

</LinearLayout>
