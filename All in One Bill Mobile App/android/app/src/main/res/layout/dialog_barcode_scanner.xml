<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_round"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_camera_scanner"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Barcode / QR Code"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScannerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Point camera at product barcode or QR"
                android:textColor="@color/colorTextMuted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnToggleFlash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Flashlight"
            android:src="@drawable/ic_flash_toggle" />

        <ImageButton
            android:id="@+id/btnCloseScanner"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Scanner"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/colorTextSecondary" />
    </LinearLayout>

    <!-- Camera Viewfinder Container -->
    <FrameLayout
        android:id="@+id/flCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="12dp"
        android:background="#000000">

        <!-- SurfaceView for camera preview -->
        <SurfaceView
            android:id="@+id/svCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay: Targeting Reticle & Scan Guide -->
        <View
            android:id="@+id/viewReticle"
            android:layout_width="220dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_scanner_reticle" />

        <!-- Animated Gold Scan Laser Line -->
        <View
            android:id="@+id/viewLaserLine"
            android:layout_width="200dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:background="@color/colorGold" />

        <!-- Fallback message for emulator or camera loading -->
        <TextView
            android:id="@+id/tvCameraPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="20dp"
            android:text="Camera Viewfinder Active\nAlign barcode or QR code inside the box"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Continuous scan switch & Last Scanned Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbContinuousScan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/colorPrimary"
            android:checked="true"
            android:text="Continuous scan (keep camera open)"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLastScannedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Ready"
            android:textColor="@color/colorPrimary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Manual Barcode Entry Fallback (for damaged labels or test entries) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etManualBarcode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Or enter barcode / code manually…"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextMuted"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitManualBarcode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="14dp"
            android:text="Add"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
