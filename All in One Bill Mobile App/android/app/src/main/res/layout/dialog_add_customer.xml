<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Party"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPartyName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Party Name *"
        android:inputType="textPersonName"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPartyPhone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Mobile Number *"
        android:inputType="phone"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPartyCity"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="City"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextMuted"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Party Type"
        android:textColor="@color/colorTextMuted"
        android:textSize="11sp" />

    <RadioGroup
        android:id="@+id/rgPartyType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbTypeCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Customer"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbTypeSupplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supplier"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp" />
    </RadioGroup>

</LinearLayout>
