<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Banner with Brand Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_drawer_header"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_drawer_avatar"
                android:contentDescription="Brand Logo"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_tsar_it" />

            <TextView
                android:id="@+id/tvProfileDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="My Business Profile"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Live Cloud Multi-Tenant Account"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Form Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Plan & Cloud Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvProfilePlanInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Active Plan: 15 Days Free Trial"
                    android:textColor="@color/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileCloudId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="⚡ Cloud Sync: Live &amp; Connected"
                    android:textColor="@color/colorSuccess"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Business Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Business / Shop Name"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileBusinessName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="Business name"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextMuted"
                android:textSize="13sp" />

            <!-- Owner Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Owner / Authorized Person"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileOwnerName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="Owner name"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextMuted"
                android:textSize="13sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Email Address (Sign-In)"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="Email (used for sign-in)"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextMuted"
                android:textSize="13sp" />

            <!-- Mobile -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mobile Number"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileMobile"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:hint="Mobile number"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextMuted"
                android:textSize="13sp" />

            <!-- Action Buttons -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProfileSave"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gold_button"
                android:text="Save &amp; Sync Changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProfileClose"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_secondary_button"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
