# Copy this file to .env for local development (never commit .env itself)
# API base URL — leave unset to auto-detect (http://localhost:8081 in dev, same-origin in production)
# REACT_APP_API_URL=http://localhost:8081

# Public brand name shown across the UI
REACT_APP_BUSINESS_NAME=TSAR IT BILLING

# Razorpay PUBLIC key id only — this is safe to embed in the browser bundle.
# The SECRET key must never be committed or exposed to the frontend.
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
